extends layout

block content
  main.homepage

    section.hero
      div.hero-text

        img.hero-logo(src="/images/DarkLogo.png" alt="Downtown Donuts logo")

        h1 Downtown Donuts
        p.family Family-Owned Since 1992
        p Fresh donuts, locally roasted coffee, and a cozy downtown spot made for mornings.

        div.hero-buttons
          a.button(href="/menu") View Menu
          a.button.secondary(href="/comments") Leave a Comment

          br

          a.button.order(href="https://www.ubereats.com" target="_blank") Order on UberEats
          a.button.order(href="https://www.doordash.com" target="_blank") Order on DoorDash

    section.home-info
      article.info-card
        h2 Fresh Daily
        p Handcrafted donuts made every morning.

      article.info-card
        h2 Order Online
        p UberEats, DoorDash, and GrubHub available.

      article.info-card
        h2 Visit Us
        p 123 Main Street, Downtown