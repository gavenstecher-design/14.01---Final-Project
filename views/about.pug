extends layout

block content
  .main-with-logos
    img.side-logo.left(src="/images/lightLogo.png" alt="Downtown Donuts logo")

    main.about-page
      section.about-hero
        h1 About Downtown Donuts
        p Family-Owned Since 1992

      section.about-content
        article.about-card
          h2 Our Story
          p Downtown Donuts started as a small family shop in 1992 with one goal: make fresh donuts and coffee for the community.

        article.about-card
          h2 What We Care About
          p We focus on quality ingredients, friendly service, and a welcoming environment.

        article.about-card
          h2 Visit Us
          p 123 Main Street, Downtown
          p Mon-Fri: 6AM-6PM
          p Sat-Sun: 7AM-4PM

    img.side-logo.right(src="/images/lightLogo.png" alt="Downtown Donuts logo")