extends layout

block content
  main
    h1 Customer Comments

    if error
      p.error-message= error

    form(method="POST", action="/comments")
      label(for="name") Name
      input(type="text", name="name", id="name", maxlength="100", required)

      label(for="comment") Comment
      textarea(name="comment", id="comment", maxlength="500", required)

      button(type="submit" onclick="this.disabled=true; this.form.submit();")
        Submit Comment

    hr

    section.comments-wrapper
      if comments && comments.length
        each c in comments
          article.comment-card
            h2= c.name
            p= c.comment
            small= c.formatted_date
      else
        p No comments yet

    if totalPages > 1
      nav.pagination
        if page > 1
          a(href=`/comments?page=${page - 1}`) Previous

        span Page #{page} of #{totalPages}

        if page < totalPages
          a(href=`/comments?page=${page + 1}`) Next